class_name MechSpriteBank
extends RefCounted

## Loads the generated mech sprite sheets (assets/battle/mechs) and their JSON metadata.
## Sheets are one row of pose cells, drawn facing right; anchors are given in the rest pose and
## shifted here by each pose's body offset (and gun recoil for gun/turret-mounted points).

const MECH_DIR := "res://assets/battle/mechs/"
const FACTION_NAMES := ["coalition", "syndikat"]

static var _meta_cache: Dictionary = {}
static var _tex_cache: Dictionary = {}     # white sheets: chassis + "_white" -> Texture2D
static var _sheet_cache: Dictionary = {}   # chassis -> [coalition tex, syndikat tex]
static var _prep_cache: Dictionary = {}    # chassis -> precomputed lookup tables (see _prep)
static var _warmed: Dictionary = {}
## Precomputed "stacks/<i>" anchor names so per-frame draws don't format strings.
const STACK_NAMES := ["stacks/0", "stacks/1", "stacks/2", "stacks/3", "stacks/4", "stacks/5", "stacks/6", "stacks/7"]

static func meta_for(chassis: String) -> Dictionary:
	if not _meta_cache.has(chassis):
		var text := FileAccess.get_file_as_string(MECH_DIR + chassis + ".json")
		var parsed = JSON.parse_string(text)
		if parsed == null:
			push_error("MechSpriteBank: missing or invalid metadata for '%s'" % chassis)
			parsed = {}
		_meta_cache[chassis] = parsed
	return _meta_cache[chassis]

static func get_sheet(chassis: String, faction: int) -> Texture2D:
	var f := clampi(faction, 0, 1)
	var pair = _sheet_cache.get(chassis)
	if pair == null:
		pair = [null, null, false, false]   # sheets per faction, then "load attempted" flags
		_sheet_cache[chassis] = pair
	if not pair[2 + f]:
		pair[2 + f] = true   # a missing sheet is reported once, not re-loaded every frame
		pair[f] = load(MECH_DIR + chassis + "_" + FACTION_NAMES[f] + ".png") as Texture2D
	return pair[f]

static var _livery_cache: Dictionary = {}   # "chassis_livery" -> Texture2D or null

## Sheet of a story livery ("blackclaw"), falling back to the faction sheet when that livery was
## never generated for the chassis.
static func get_livery_sheet(chassis: String, faction: int, livery: String) -> Texture2D:
	if livery == "":
		return get_sheet(chassis, faction)
	var key := chassis + "_" + livery
	if not _livery_cache.has(key):
		var path := MECH_DIR + key + ".png"
		_livery_cache[key] = load(path) as Texture2D if ResourceLoader.exists(path) else null
	var tex: Texture2D = _livery_cache[key]
	return tex if tex != null else get_sheet(chassis, faction)

## White silhouette of a sheet (FF6 hit flash, ghosts, glows). Pre-generated by the art generator
## so nothing is built per pixel at impact time; identical for both factions.
static func get_white_sheet(chassis: String, _faction: int = 0) -> Texture2D:
	if not _tex_cache.has(chassis):   # cache misses too: a missing sheet is reported once
		_tex_cache[chassis] = load(MECH_DIR + chassis + "_white.png") as Texture2D
	return _tex_cache[chassis]

## Loads a chassis' sheets (both factions + white silhouette) and every variant sheet listed in its
## metadata, so nothing is loaded lazily mid-animation. Safe to call repeatedly.
static func warm(chassis: String) -> void:
	if _warmed.has(chassis):
		return
	_warmed[chassis] = true
	if not FileAccess.file_exists(MECH_DIR + chassis + ".json"):
		return
	_prep(chassis)
	for f in 2:
		get_sheet(chassis, f)
	get_white_sheet(chassis)
	var variants: Dictionary = meta_for(chassis).get("variants", {})
	for v in variants.values():
		if String(v) != "":
			warm(String(v))

## Per-chassis lookup tables built once from the metadata: pose -> frame Rect2 / offset / gun
## recoil, idle pose names, cell size, and a lazily filled anchor-name cache.
static func _prep(chassis: String) -> Dictionary:
	var pr = _prep_cache.get(chassis)
	if pr != null:
		return pr
	var m := meta_for(chassis)
	var size := Vector2(float(m.get("w", 0)), float(m.get("h", 0)))
	var rects := {}
	var poses: Array = m.get("poses", [])
	for i in poses.size():
		if not rects.has(poses[i]):   # Array.find returns the first match
			rects[poses[i]] = Rect2(Vector2(i * size.x, 0), size)
	var offs := {}
	for k in m.get("pose_off", {}):
		var o = m["pose_off"][k]
		offs[k] = Vector2(o[0], o[1])
	var guns := {}
	for k in m.get("pose_gun", {}):
		guns[k] = float(m["pose_gun"][k])
	var frames: int = maxi(1, int(m.get("idle_frames", 6)))
	var idle: Array[String] = []
	for i in frames:
		idle.append("idle%d" % i)
	var anchors: Dictionary = m.get("anchors", {})
	var bricks = anchors.get("bricks", null)
	pr = {
		"n_stacks": (anchors.get("stacks", []) as Array).size(),
		"bricks": Vector2(bricks[0], bricks[1]) if bricks != null else null,
		"size": size, "rects": rects, "rect0": Rect2(Vector2.ZERO, size), "off": offs, "gun": guns,
		"idle": idle, "idle_step": maxf(1.0, float(m.get("idle_ms", 150))), "anch": {},
	}
	_prep_cache[chassis] = pr
	return pr

## Number of exhaust stack anchors of a sheet (precomputed: read every frame).
static func stack_count(chassis: String) -> int:
	return _prep(chassis)["n_stacks"]

## Top-left of the reactive-bricks rectangle in the rest pose, or null when the chassis has none.
static func bricks_anchor(chassis: String) -> Variant:
	return _prep(chassis)["bricks"]

static var _muzzle_names: Dictionary = {}

## "muzzles/<weapon_id>", built once per weapon id instead of per frame.
static func muzzle_name(weapon_id: String) -> String:
	var n = _muzzle_names.get(weapon_id)
	if n == null:
		n = "muzzles/" + weapon_id
		_muzzle_names[weapon_id] = n
	return n

static func cell_size(chassis: String) -> Vector2:
	return _prep(chassis)["size"]

static func frame_rect(chassis: String, pose: String) -> Rect2:
	var pr := _prep(chassis)
	return pr["rects"].get(pose, pr["rect0"])

static func idle_pose(chassis: String, t_ms: float) -> String:
	var pr := _prep(chassis)
	var idle: Array = pr["idle"]
	return idle[int(t_ms / float(pr["idle_step"])) % idle.size()]

## Monotonic index of the idle frame shown at `t_ms`; it changes exactly when idle_pose() may.
## Lets a UI redraw only when an idle portrait actually steps.
static func idle_frame(chassis: String, t_ms: float) -> int:
	return int(t_ms / float(_prep(chassis)["idle_step"]))

static func pose_offset(chassis: String, pose: String) -> Vector2:
	return _prep(chassis)["off"].get(pose, Vector2.ZERO)

static func pose_gun(chassis: String, pose: String) -> float:
	return _prep(chassis)["gun"].get(pose, 0.0)

## name: "feet" | "hull" | "glacis" | "viewport" | "stacks/<i>" | "muzzles/<weapon_id>" | "attach/<name>"
static func anchor(chassis: String, name: String, pose: String, mirrored: bool) -> Vector2:
	var pr := _prep(chassis)
	var ent = pr["anch"].get(name)
	if ent == null:
		ent = _resolve_anchor(chassis, name)
		pr["anch"][name] = ent
	var p: Vector2 = ent["p"]
	if name != "feet":
		var off: Vector2 = pr["off"].get(pose, Vector2.ZERO)
		var gun: float = pr["gun"].get(pose, 0.0)
		var grp: String = ent["grp"]
		if grp == "gun":
			off.x += gun
		elif grp == "turret":
			off.x += roundf(gun / 3.0)
		p += off
	if mirrored:
		# the mirrored draw puts pixel column x at w - 1 - x
		p.x = pr["size"].x - 1.0 - p.x
	return p

static func _resolve_anchor(chassis: String, name: String) -> Dictionary:
	var anchors: Dictionary = meta_for(chassis).get("anchors", {})
	var parts := name.split("/")
	var raw = null
	var grp := ""
	if parts.size() == 1:
		raw = anchors.get(name, null)
	elif parts[0] == "stacks":
		var stacks: Array = anchors.get("stacks", [])
		var i := int(parts[1])
		raw = stacks[i] if i < stacks.size() else null
	elif parts[0] == "muzzles":
		var mz = anchors.get("muzzles", {}).get(parts[1], null)
		if mz != null:
			raw = mz["p"]
			grp = String(mz.get("grp", ""))
	else:
		raw = anchors.get(parts[0], {}).get(parts[1], null)
	if raw == null:
		raw = anchors.get("hull", [0, 0])
	return {"p": Vector2(raw[0], raw[1]), "grp": grp}
