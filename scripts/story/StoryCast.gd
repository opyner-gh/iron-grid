class_name StoryCast
extends RefCounted

## The story mode's speaking cast: display names, sides and portraits (assets/story/portraits,
## generated by tools/battle_sprites/portraits.py). A dialog line names its speaker by these ids;
## "" is the narrator.

const PORTRAIT_DIR := "res://assets/story/portraits/"
const PORTRAIT_SIZE := 48
const COALITION := 0
const SYNDIKAT := 1

## id -> {name (dialog box), roster (shorter name for line-up lists, optional), side, chassis (the
## walker they pilot, "" for none)}
const CAST: Dictionary = {
	"leon": {"name": "LT. LEON HAMMERFELD", "side": COALITION, "chassis": "vanguard"},
	"leon_child": {"name": "LEON", "side": COALITION, "chassis": ""},
	"mira": {"name": "LT. MIRA KESSLER", "side": COALITION, "chassis": "falke"},
	"chad": {"name": "SGT. CHAD BREWSTER", "side": COALITION, "chassis": "moloch"},
	"brann": {"name": "GEN. BRANN 'OLD IRON' HAMMERFELD", "roster": "GEN. BRANN HAMMERFELD", "side": COALITION, "chassis": "goliath"},
	"hq": {"name": "8TH DIVISION SIGNALS", "side": COALITION, "chassis": ""},
	"wolfram": {"name": "WOLFRAM", "side": SYNDIKAT, "chassis": "kommandant"},
	"konrad": {"name": "KONRAD VARGA", "side": SYNDIKAT, "chassis": "kommandant"},
	"ilse": {"name": "CMDR. ILSE ROTMANN", "side": SYNDIKAT, "chassis": "donner"},
	"grau": {"name": "SUPREME MARSHAL GRAU", "side": SYNDIKAT, "chassis": "ragnarok"},
	"syndikat": {"name": "SYNDIKAT OFFICER", "side": SYNDIKAT, "chassis": ""},
}

static var _portraits: Dictionary = {}

static func has(id: String) -> bool:
	return CAST.has(id)

static func display_name(id: String) -> String:
	return CAST[id]["name"] if CAST.has(id) else id.to_upper()

## The name for narrow line-up lists.
static func roster_name(id: String) -> String:
	return CAST[id].get("roster", CAST[id]["name"]) if CAST.has(id) else id.to_upper()

static func side(id: String) -> int:
	return int(CAST[id]["side"]) if CAST.has(id) else -1

## The pilot's portrait, or null when the id is unknown or the art is missing (callers draw a blank frame).
static func portrait(id: String) -> Texture2D:
	if not _portraits.has(id):
		var path := PORTRAIT_DIR + id + ".png"
		_portraits[id] = load(path) as Texture2D if id != "" and ResourceLoader.exists(path) else null
	return _portraits[id]
